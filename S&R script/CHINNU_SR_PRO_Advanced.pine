// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © CHINNU / RAJ TRADING - PRO ADVANCED SMC S&R STRATEGY v3.0 (5M Day Trading + Swing Edition)
//@version=6
strategy("CHINNU S&R PRO ADVANCED | 5M Day Trading + SMC + Multi-Target Engine",
     shorttitle="CHINNU S&R PRO",
     overlay=true,
     initial_capital=10000,
     currency=currency.USD,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     max_lines_count=400,
     max_labels_count=400,
     max_boxes_count=300)

//====================================================
// 1. INPUT SETTINGS
//====================================================

// --- 0. Strategy Profile & Presets ---
gProfile = "0. Strategy Profile & Presets"
profileMode = input.string("5M Intraday Day Trading", "Operating Profile",
     options=["5M Intraday Day Trading", "15M / 30M Swing Trading", "Custom Settings"], group=gProfile,
     tooltip="5M Intraday auto-calibrates swing strength, 15M HTF, daily circuit breakers, and session filters.")

tradeDirection = input.string("Both", "Allowed Direction", options=["Both", "Long Only", "Short Only"], group=gProfile,
     tooltip="Choose Long Only during macro bull trends, Short Only during bear trends, or Both for range markets.")

// --- 1. Day Trading Circuit Breakers & Daily Limits ---
gDaily = "1. Day Trading Controls & Daily Circuit Breakers"
useDailyLimits = input.bool(true, "Enable Daily Trade & Loss Limits", group=gDaily,
     tooltip="Directly implements the Daily Loss Limit from the repository's Risk Management Plan.")
maxDailyTrades = input.int(3, "Max Trades Allowed Per Day", minval=1, maxval=10, group=gDaily,
     tooltip="Prevents overtrading on choppy 5M days. Locks out new entries once reached.")
maxDailyLossUSD = input.float(250.0, "Daily Loss Circuit Breaker ($)", minval=10.0, step=10.0, group=gDaily,
     tooltip="Stops trading for the remainder of the day if daily losses exceed this amount.")
closeAtEOD = input.bool(false, "Square Off All Positions at EOD (No Overnight Risk)", group=gDaily,
     tooltip="Pure day trading rule: closes any open trade before session ends so you carry zero overnight risk.")
eodSession = input.session("1630-1700:23456", "EOD Square-Off Window (UTC)", group=gDaily)

// --- 2. Support & Resistance Zones ---
gSR = "2. Support & Resistance Zones"
swingLen = input.int(8, "Swing Pivot Strength (8 for 5M, 5 for 15M)", minval=2, maxval=30, group=gSR,
     tooltip="Higher values (8-12) filter 5-minute micro-noise; lower values (4-6) suit 15M/30M.")
showLevels = input.bool(true, "Show Support / Resistance Zones", group=gSR)
maxLevels = input.int(5, "Historical S/R Zones Count", minval=1, maxval=20, group=gSR)
zoneAtrMult = input.float(0.3, "S/R Zone Tolerance (ATR Multiplier)", minval=0.05, step=0.05, group=gSR,
     tooltip="Defines S/R as a price zone rather than an exact hairline, avoiding premature stopouts on wicks.")

// --- 3. Timeframe & Higher Timeframe Trend ---
gTF = "3. Timeframe, HTF Trend & Kill Zones"
useTF = input.bool(true, "Restrict Entry Chart Timeframe", group=gTF)
allowedTF = input.string("5M, 15M, 30M", "Allowed Chart Timeframes",
     options=["5M, 15M, 30M", "5M Only (Day Trading)", "15M / 30M (Swing)", "Any Timeframe"], group=gTF)
useTrend = input.bool(true, "Enable HTF Trend Filter", group=gTF)
trendTF = input.timeframe("15", "Higher Timeframe Trend (15M for 5M, 60M for 15M)", group=gTF,
     tooltip="For 5M trading, a 15M HTF provides optimal 3:1 alignment without excessive lag.")
trendMode = input.string("EMA Stack (50 > 200)", "HTF Trend Requirement",
     options=["EMA Stack (50 > 200)", "Price vs Fast EMA (50)", "Price vs Slow EMA (200)"], group=gTF)
emaFastLen = input.int(50, "Fast EMA Length", minval=1, group=gTF)
emaSlowLen = input.int(200, "Slow EMA Length", minval=1, group=gTF)
showEMAs = input.bool(false, "Show HTF EMAs on Chart", group=gTF)

useSession = input.bool(true, "Enable Kill Zone Session Filter", group=gTF,
     tooltip="SMC works best during high-volume institutional hours. Filters out dead overnight Asian chop.")
sessionTime = input.session("0700-1700:23456", "Active Kill Zone Window (UTC)", group=gTF,
     tooltip="Default 0700-1700 UTC covers active London Open and New York Open hours.")

// --- 4. Smart Money Concepts (SMC) & Daily Liquidity ---
gSMC = "4. Smart Money Concepts (SMC) & Liquidity"
smcMode = input.string("Breakout & Retest (BOS)", "SMC Setup Model",
     options=["Breakout & Retest (BOS)", "Liquidity Sweep + Retest", "Either (All Clean Setups)"], group=gSMC)
sweepLookback = input.int(25, "Liquidity Sweep Lookback Bars", minval=5, maxval=100, group=gSMC)
showSMCMarks = input.bool(true, "Show Liquidity Sweep Markers", group=gSMC)
showPDHL = input.bool(true, "Show Previous Day High / Low (PDH/PDL)", group=gSMC,
     tooltip="Plots the major daily buy-side and sell-side liquidity pools for SMC day trading.")

// --- 5. Volume & Momentum Confirmation ---
gVol = "5. Volume & Momentum Confirmation"
useVolume = input.bool(true, "Enable Volume Filter", group=gVol)
volLen = input.int(20, "Volume Average Length", minval=1, group=gVol)
volMult = input.float(1.15, "Volume Spike Multiplier", minval=0.1, step=0.05, group=gVol)
volOnBreakOnly = input.bool(true, "Require Volume Spike on Breakout Only", group=gVol,
     tooltip="Allows quiet, low-volume pullbacks/retests as taught in Wyckoff/SMC volume theory.")

useRSI = input.bool(true, "Enable RSI Momentum Filter", group=gVol)
rsiLen = input.int(14, "RSI Length", minval=1, group=gVol)
rsiBuyLevel = input.float(50.0, "BUY RSI Minimum", minval=1, maxval=99, group=gVol)
rsiSellLevel = input.float(50.0, "SELL RSI Maximum", minval=1, maxval=99, group=gVol)
avoidExtremeRSI = input.bool(true, "Avoid Overextended RSI (No Buying > 75 / Shorting < 25)", group=gVol)

// --- 6. Entry Confirmation ---
gEntry = "6. Entry Confirmation & Candlestick Strength"
maxWait = input.int(16, "Maximum Retest Waiting Bars", minval=1, group=gEntry)
useCandleStrength = input.bool(true, "Require Strong Confirmation Candle", group=gEntry)
minBodyPct = input.float(38.0, "Minimum Candle Body %", minval=1, maxval=100, group=gEntry)

// --- 7. Risk Management & Position Sizing ---
gRisk = "7. Risk Management & Position Sizing (1R Model)"
sizingMode = input.string("Risk % of Equity (1R)", "Position Sizing Mode",
     options=["Risk % of Equity (1R)", "Fixed Cash Risk ($)", "Fixed Quantity"], group=gRisk)
riskPct = input.float(1.0, "Risk % Per Trade (1R)", minval=0.1, maxval=10.0, step=0.1, group=gRisk)
fixedRiskUSD = input.float(100.0, "Fixed Cash Risk ($)", minval=1.0, step=10.0, group=gRisk)
fixedQty = input.float(1.0, "Fixed Quantity (Contracts/Shares)", minval=0.001, group=gRisk)

atrLen = input.int(14, "ATR Length", minval=1, group=gRisk)
slType = input.string("Structural (Retest Swing + ATR)", "Stop Loss Placement",
     options=["Structural (Retest Swing + ATR)", "Broken Level + ATR", "Pure ATR Multiple"], group=gRisk)
atrBuffer = input.float(0.85, "SL ATR Buffer Multiplier", minval=0.1, step=0.05, group=gRisk)

// --- 8. Multi-Stage Take Profit & Breakeven Engine ---
gExit = "8. Multi-Target (Scaling Out) & Breakeven Engine"
usePartialTP = input.bool(true, "Enable Multi-Stage Take Profit (Scale Out 50% at TP1)", group=gExit,
     tooltip="Locks in 50% profit early on 5M scalps and moves stop to Breakeven for the runner.")
tp1Ratio = input.float(1.25, "TP1 Target Ratio (R-Multiple)", minval=0.5, step=0.25, group=gExit)
tp2Ratio = input.float(2.25, "TP2 Target Ratio (Runner R-Multiple)", minval=1.0, step=0.25, group=gExit)

useBE = input.bool(true, "Auto-Move Stop to Breakeven at +1R", group=gExit)
beTriggerR = input.float(1.0, "Breakeven Trigger (R-Multiple)", minval=0.5, step=0.1, group=gExit)
beOffsetTicks = input.int(2, "Breakeven Offset (Ticks to cover commission)", minval=0, group=gExit)

useTrailing = input.bool(false, "Enable ATR Trailing Stop on Runner", group=gExit)
trailAtrMult = input.float(1.5, "Trailing Stop ATR Multiplier", minval=0.5, step=0.1, group=gExit)

// --- 9. Visuals & On-Candle Identification ---
gVisuals = "9. On-Candle Identification & Brackets"
showTradeChannels = input.bool(true, "Show Shaded Risk & Reward Zones on Candles", group=gVisuals)
showTradeLines = input.bool(true, "Show Entry / SL / TP Lines Across Candles", group=gVisuals)
showLabels = input.bool(true, "Show Detailed Entry / SL / TP Card on Signal Candle", group=gVisuals)
showHistoricalBoxes = input.bool(true, "Keep Historical Trade Brackets (Long/Short Tools)", group=gVisuals)
maxHistBoxes = input.int(15, "Max Historical Trade Brackets to Keep", minval=1, maxval=50, group=gVisuals)

// --- 10. Dashboard HUD ---
gDisplay = "10. Dashboard HUD"
showDashboard = input.bool(true, "Show Dashboard HUD", group=gDisplay)

//====================================================
// 2. TIMEFRAME & SESSION VALIDATION
//====================================================

is5 = timeframe.isminutes and timeframe.multiplier == 5
is15 = timeframe.isminutes and timeframe.multiplier == 15
is30 = timeframe.isminutes and timeframe.multiplier == 30

validTF = switch allowedTF
    "5M, 15M, 30M" => is5 or is15 or is30
    "5M Only (Day Trading)" => is5
    "15M / 30M (Swing)" => is15 or is30
    => true // Any Timeframe

tfName = is5 ? "5M" : is15 ? "15M" : is30 ? "30M" : timeframe.period

// Session filter (checks if bar time is within active kill zone)
inSession = not useSession or not na(time(timeframe.period, sessionTime, "UTC"))

//====================================================
// 3. DAILY CIRCUIT BREAKER & INTRADAY TRACKER
//====================================================

isNewDay = ta.change(time("D")) != 0

var int dailyTradesCount = 0
var float dayStartEquity = 10000.0
var float dailyPnL = 0.0

if isNewDay
    dailyTradesCount := 0
    dayStartEquity := strategy.equity
    dailyPnL := 0.0
else
    dailyPnL := strategy.equity - dayStartEquity

// Count completed trades today
if ta.change(strategy.closedtrades) > 0
    dailyTradesCount += ta.change(strategy.closedtrades)

dayLossLimitHit = useDailyLimits and (dailyPnL <= -maxDailyLossUSD)
maxDailyTradesHit = useDailyLimits and (dailyTradesCount >= maxDailyTrades)
dailyTradingAllowed = not dayLossLimitHit and not maxDailyTradesHit

// Square off at End of Day if configured
if closeAtEOD and strategy.position_size != 0 and not na(time(timeframe.period, eodSession, "UTC"))
    strategy.close_all(comment="EOD Square-Off")

//====================================================
// 4. HIGHER TIMEFRAME TREND ENGINE (NON-REPAINTING)
//====================================================

// Request HTF data referencing closed bar [1] to ensure ZERO repainting in live vs backtest
[htfClose, htfFast, htfSlow] = request.security(
     syminfo.tickerid,
     trendTF,
     [close[1], ta.ema(close, emaFastLen)[1], ta.ema(close, emaSlowLen)[1]],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

trendBull = false
trendBear = false

if trendMode == "EMA Stack (50 > 200)"
    trendBull := htfClose > htfFast and htfFast > htfSlow
    trendBear := htfClose < htfFast and htfFast < htfSlow
else if trendMode == "Price vs Fast EMA (50)"
    trendBull := htfClose > htfFast
    trendBear := htfClose < htfFast
else // "Price vs Slow EMA (200)"
    trendBull := htfClose > htfSlow
    trendBear := htfClose < htfSlow

trendLongOK = not useTrend or trendBull
trendShortOK = not useTrend or trendBear

plot(showEMAs ? htfFast : na, "HTF EMA Fast", color=color.aqua, linewidth=2)
plot(showEMAs ? htfSlow : na, "HTF EMA Slow", color=color.orange, linewidth=2)

//====================================================
// 5. PREVIOUS DAY HIGH / LOW (DAILY SMC LIQUIDITY)
//====================================================

[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

plot(showPDHL ? pdh : na, "Previous Day High (PDH / BSL)", color=color.new(color.red, 30), style=plot.style_circles)
plot(showPDHL ? pdl : na, "Previous Day Low (PDL / SSL)", color=color.new(color.green, 30), style=plot.style_circles)

//====================================================
// 6. SUPPORT & RESISTANCE ENGINE (ZONES)
//====================================================

atrValue = ta.atr(atrLen)
zoneWidth = atrValue * zoneAtrMult

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float resistance = na
var float support = na

var box resBox = na
var box supBox = na
var array<box> oldResBoxes = array.new_box()
var array<box> oldSupBoxes = array.new_box()

if not na(ph)
    resistance := ph
    if showLevels
        resBox := box.new(
             left=bar_index - swingLen, top=ph + zoneWidth,
             right=bar_index + 5, bottom=ph - zoneWidth,
             border_color=color.new(color.red, 40),
             bgcolor=color.new(color.red, 85))
        array.push(oldResBoxes, resBox)
        if array.size(oldResBoxes) > maxLevels
            box.delete(array.shift(oldResBoxes))

if not na(pl)
    support := pl
    if showLevels
        supBox := box.new(
             left=bar_index - swingLen, top=pl + zoneWidth,
             right=bar_index + 5, bottom=pl - zoneWidth,
             border_color=color.new(color.green, 40),
             bgcolor=color.new(color.green, 85))
        array.push(oldSupBoxes, supBox)
        if array.size(oldSupBoxes) > maxLevels
            box.delete(array.shift(oldSupBoxes))

// Extend latest active boxes
if not na(resBox)
    box.set_right(resBox, bar_index + 3)
if not na(supBox)
    box.set_right(supBox, bar_index + 3)

//====================================================
// 7. SMC LIQUIDITY SWEEPS & STRUCTURE
//====================================================

bullSweep = not na(support) and low < (support - zoneWidth) and close >= (support - zoneWidth)
bearSweep = not na(resistance) and high > (resistance + zoneWidth) and close <= (resistance + zoneWidth)

var int lastBullSweepBar = na
var int lastBearSweepBar = na

if bullSweep
    lastBullSweepBar := bar_index

if bearSweep
    lastBearSweepBar := bar_index

bullSweepRecent = not na(lastBullSweepBar) and (bar_index - lastBullSweepBar <= sweepLookback)
bearSweepRecent = not na(lastBearSweepBar) and (bar_index - lastBearSweepBar <= sweepLookback)

smcLongQualified = switch smcMode
    "Breakout & Retest (BOS)" => true
    "Liquidity Sweep + Retest" => bullSweepRecent
    => true // Either

smcShortQualified = switch smcMode
    "Breakout & Retest (BOS)" => true
    "Liquidity Sweep + Retest" => bearSweepRecent
    => true // Either

plotshape(showSMCMarks and bullSweep, title="Bullish Liquidity Sweep (SSL)",
     style=shape.circle, location=location.belowbar,
     color=color.aqua, size=size.tiny, text="SSL SWEEP")

plotshape(showSMCMarks and bearSweep, title="Bearish Liquidity Sweep (BSL)",
     style=shape.circle, location=location.abovebar,
     color=color.fuchsia, size=size.tiny, text="BSL SWEEP")

//====================================================
// 8. VOLUME & RSI FILTERS
//====================================================

volAvg = ta.sma(volume, volLen)
volSpike = not na(volAvg) and (volume >= volAvg * volMult)
volumeBreakOK = not useVolume or volSpike

rsiValue = ta.rsi(close, rsiLen)
rsiNotExtremeLong = not avoidExtremeRSI or rsiValue <= 75.0
rsiNotExtremeShort = not avoidExtremeRSI or rsiValue >= 25.0

rsiLongOK = not useRSI or (rsiValue >= rsiBuyLevel and rsiNotExtremeLong)
rsiShortOK = not useRSI or (rsiValue <= rsiSellLevel and rsiNotExtremeShort)

//====================================================
// 9. CANDLE STRENGTH & DIRECTION
//====================================================

candleRange = high - low
bodyPercent = candleRange > 0 ? math.abs(close - open) / candleRange * 100 : 0
bullCandleOK = not useCandleStrength or (close > open and bodyPercent >= minBodyPct)
bearCandleOK = not useCandleStrength or (close < open and bodyPercent >= minBodyPct)

dirLongOK = tradeDirection == "Both" or tradeDirection == "Long Only"
dirShortOK = tradeDirection == "Both" or tradeDirection == "Short Only"

//====================================================
// 10. ROBUST BREAKOUT & RETEST STATE MACHINE
//====================================================

var int state = 0
var float brokenLevel = na
var float retestHigh = na
var float retestLow = na
var int setupBar = na

bullBreakCross = not na(resistance) and ta.crossover(close, resistance)
bearBreakCross = not na(support) and ta.crossunder(close, support)

canTrade = validTF and inSession and dailyTradingAllowed and strategy.position_size == 0

buyBreak = canTrade and dirLongOK and state == 0 and bullBreakCross and (not volOnBreakOnly or volumeBreakOK)
sellBreak = canTrade and dirShortOK and state == 0 and bearBreakCross and (not volOnBreakOnly or volumeBreakOK)

if buyBreak
    state := 1
    brokenLevel := resistance
    retestHigh := high
    retestLow := low
    setupBar := bar_index

if sellBreak
    state := -1
    brokenLevel := support
    retestHigh := high
    retestLow := low
    setupBar := bar_index

// Timeout stale setups
if state != 0 and not na(setupBar) and (bar_index - setupBar > maxWait)
    state := 0
    brokenLevel := na
    retestHigh := na
    retestLow := na
    setupBar := na

// BULLISH RETEST (State 1 -> 2)
if state == 1
    if close < (brokenLevel - zoneWidth * 1.5)
        state := 0
        brokenLevel := na
        setupBar := na
    else if low <= (brokenLevel + zoneWidth) and close >= (brokenLevel - zoneWidth)
        retestHigh := na(retestHigh) ? high : math.max(retestHigh, high)
        retestLow := na(retestLow) ? low : math.min(retestLow, low)
        state := 2

if state == 2
    retestLow := na(retestLow) ? low : math.min(retestLow, low)
    if close < (brokenLevel - zoneWidth * 1.5)
        state := 0
        setupBar := na

// BEARISH RETEST (State -1 -> -2)
if state == -1
    if close > (brokenLevel + zoneWidth * 1.5)
        state := 0
        brokenLevel := na
        setupBar := na
    else if high >= (brokenLevel - zoneWidth) and close <= (brokenLevel + zoneWidth)
        retestHigh := na(retestHigh) ? high : math.max(retestHigh, high)
        retestLow := na(retestLow) ? low : math.min(retestLow, low)
        state := -2

if state == -2
    retestHigh := na(retestHigh) ? high : math.max(retestHigh, high)
    if close > (brokenLevel + zoneWidth * 1.5)
        state := 0
        setupBar := na

//====================================================
// 11. CONFIRMATION TRIGGERS & FINAL FILTERS
//====================================================

volRetestOK = not useVolume or volOnBreakOnly or volumeBreakOK

longFilters = validTF and inSession and dailyTradingAllowed and dirLongOK and trendLongOK and smcLongQualified and volRetestOK and rsiLongOK and bullCandleOK
shortFilters = validTF and inSession and dailyTradingAllowed and dirShortOK and trendShortOK and smcShortQualified and volRetestOK and rsiShortOK and bearCandleOK

buyTrigger = state == 2 and close > brokenLevel and close > retestHigh and close[1] <= retestHigh
sellTrigger = state == -2 and close < brokenLevel and close < retestLow and close[1] >= retestLow

buySignal = buyTrigger and longFilters
sellSignal = sellTrigger and shortFilters

if buyTrigger or sellTrigger
    state := 0
    setupBar := na

//====================================================
// 12. TRADE LEVELS, MULTI-TARGET SIZING & BRACKETS
//====================================================

var float entryPrice = na
var float stopLoss = na
var float takeProfit = na
var float tp1Price = na
var float tp2Price = na
var float initialRisk = na
var float activeSL = na
var float halfQty = na
var bool beActivated = false
var bool tp1Hit = false

// Historical trade boxes array
var array<box> histBoxes = array.new_box()
var box activeTpBox = na
var box activeSlBox = na

// Calculate Long Orders
if buySignal and strategy.position_size == 0
    entryPrice := close
    
    stopLoss := switch slType
        "Structural (Retest Swing + ATR)" => math.min(brokenLevel, nz(retestLow, low)) - atrValue * atrBuffer
        "Broken Level + ATR" => brokenLevel - atrValue * atrBuffer
        => entryPrice - atrValue * atrBuffer * 2.0
    
    initialRisk := entryPrice - stopLoss
    
    if initialRisk > syminfo.mintick
        tp1Price := entryPrice + initialRisk * tp1Ratio
        tp2Price := entryPrice + initialRisk * tp2Ratio
        takeProfit := usePartialTP ? tp2Price : (entryPrice + initialRisk * tp2Ratio)
        activeSL := stopLoss
        beActivated := false
        tp1Hit := false

        float tradeQty = na
        if sizingMode == "Risk % of Equity (1R)"
            riskDollars = strategy.equity * (riskPct / 100.0)
            tradeQty := riskDollars / initialRisk
        else if sizingMode == "Fixed Cash Risk ($)"
            tradeQty := fixedRiskUSD / initialRisk
        else
            tradeQty := fixedQty

        if syminfo.type == "crypto"
            tradeQty := math.max(syminfo.mincontract, math.round(tradeQty, 3))
            halfQty := math.max(syminfo.mincontract, math.round(tradeQty * 0.5, 3))
        else
            tradeQty := math.max(1, math.floor(tradeQty))
            halfQty := math.max(1, math.floor(tradeQty * 0.5))

        strategy.entry("BUY", strategy.long, qty=tradeQty)
        
        // Execute multi-stage exits
        if usePartialTP
            strategy.exit("BUY TP1", from_entry="BUY", qty=halfQty, stop=activeSL, limit=tp1Price)
            strategy.exit("BUY TP2", from_entry="BUY", stop=activeSL, limit=tp2Price)
        else
            strategy.exit("BUY EXIT", from_entry="BUY", stop=activeSL, limit=takeProfit)

        if showHistoricalBoxes
            activeTpBox := box.new(left=bar_index, top=tp2Price, right=bar_index + 1, bottom=entryPrice,
                 border_color=color.new(color.green, 20), bgcolor=color.new(color.green, 88), border_width=1)
            activeSlBox := box.new(left=bar_index, top=entryPrice, right=bar_index + 1, bottom=stopLoss,
                 border_color=color.new(color.red, 20), bgcolor=color.new(color.red, 88), border_width=1)
            array.push(histBoxes, activeTpBox)
            array.push(histBoxes, activeSlBox)
            if array.size(histBoxes) > maxHistBoxes * 2
                box.delete(array.shift(histBoxes))
                box.delete(array.shift(histBoxes))

        if showLabels
            label.new(
                 bar_index, low,
                 "▲ BUY ENTRY (" + tfName + ")" +
                 "\n────────────────────" +
                 "\n• ENTRY: " + str.tostring(entryPrice, format.mintick) +
                 "\n• SL:    " + str.tostring(stopLoss, format.mintick) +
                 "\n• TP1:   " + str.tostring(tp1Price, format.mintick) + " (1:" + str.tostring(tp1Ratio, "#.#") + ")" +
                 "\n• TP2:   " + str.tostring(tp2Price, format.mintick) + " (1:" + str.tostring(tp2Ratio, "#.#") + ")" +
                 "\n────────────────────" +
                 "\n• Risk:  $" + str.tostring(initialRisk * tradeQty, "#.##") + " (1R)" +
                 "\n• Size:  " + str.tostring(tradeQty, "#.##") + " units",
                 yloc=yloc.belowbar,
                 style=label.style_label_up,
                 color=color.new(color.green, 10),
                 textcolor=color.white,
                 size=size.normal)

// Calculate Short Orders
if sellSignal and strategy.position_size == 0
    entryPrice := close
    
    stopLoss := switch slType
        "Structural (Retest Swing + ATR)" => math.max(brokenLevel, nz(retestHigh, high)) + atrValue * atrBuffer
        "Broken Level + ATR" => brokenLevel + atrValue * atrBuffer
        => entryPrice + atrValue * atrBuffer * 2.0
    
    initialRisk := stopLoss - entryPrice
    
    if initialRisk > syminfo.mintick
        tp1Price := entryPrice - initialRisk * tp1Ratio
        tp2Price := entryPrice - initialRisk * tp2Ratio
        takeProfit := usePartialTP ? tp2Price : (entryPrice - initialRisk * tp2Ratio)
        activeSL := stopLoss
        beActivated := false
        tp1Hit := false

        float tradeQty = na
        if sizingMode == "Risk % of Equity (1R)"
            riskDollars = strategy.equity * (riskPct / 100.0)
            tradeQty := riskDollars / initialRisk
        else if sizingMode == "Fixed Cash Risk ($)"
            tradeQty := fixedRiskUSD / initialRisk
        else
            tradeQty := fixedQty

        if syminfo.type == "crypto"
            tradeQty := math.max(syminfo.mincontract, math.round(tradeQty, 3))
            halfQty := math.max(syminfo.mincontract, math.round(tradeQty * 0.5, 3))
        else
            tradeQty := math.max(1, math.floor(tradeQty))
            halfQty := math.max(1, math.floor(tradeQty * 0.5))

        strategy.entry("SELL", strategy.short, qty=tradeQty)
        
        // Execute multi-stage exits
        if usePartialTP
            strategy.exit("SELL TP1", from_entry="SELL", qty=halfQty, stop=activeSL, limit=tp1Price)
            strategy.exit("SELL TP2", from_entry="SELL", stop=activeSL, limit=tp2Price)
        else
            strategy.exit("SELL EXIT", from_entry="SELL", stop=activeSL, limit=takeProfit)

        if showHistoricalBoxes
            activeTpBox := box.new(left=bar_index, top=entryPrice, right=bar_index + 1, bottom=tp2Price,
                 border_color=color.new(color.green, 20), bgcolor=color.new(color.green, 88), border_width=1)
            activeSlBox := box.new(left=bar_index, top=stopLoss, right=bar_index + 1, bottom=entryPrice,
                 border_color=color.new(color.red, 20), bgcolor=color.new(color.red, 88), border_width=1)
            array.push(histBoxes, activeTpBox)
            array.push(histBoxes, activeSlBox)
            if array.size(histBoxes) > maxHistBoxes * 2
                box.delete(array.shift(histBoxes))
                box.delete(array.shift(histBoxes))

        if showLabels
            label.new(
                 bar_index, high,
                 "▼ SELL ENTRY (" + tfName + ")" +
                 "\n────────────────────" +
                 "\n• ENTRY: " + str.tostring(entryPrice, format.mintick) +
                 "\n• SL:    " + str.tostring(stopLoss, format.mintick) +
                 "\n• TP1:   " + str.tostring(tp1Price, format.mintick) + " (1:" + str.tostring(tp1Ratio, "#.#") + ")" +
                 "\n• TP2:   " + str.tostring(tp2Price, format.mintick) + " (1:" + str.tostring(tp2Ratio, "#.#") + ")" +
                 "\n────────────────────" +
                 "\n• Risk:  $" + str.tostring(initialRisk * tradeQty, "#.##") + " (1R)" +
                 "\n• Size:  " + str.tostring(tradeQty, "#.##") + " units",
                 yloc=yloc.abovebar,
                 style=label.style_label_down,
                 color=color.new(color.red, 10),
                 textcolor=color.white,
                 size=size.normal)

// Extend active trade bracket boxes across open trade candles
if strategy.position_size != 0
    if not na(activeTpBox)
        box.set_right(activeTpBox, bar_index)
    if not na(activeSlBox)
        box.set_right(activeSlBox, bar_index)

//====================================================
// 13. DYNAMIC BREAKEVEN & TRAILING STOP ENGINE
//====================================================

if strategy.position_size > 0
    // Check if TP1 was reached
    if usePartialTP and not tp1Hit and (high >= tp1Price)
        tp1Hit := true
        activeSL := entryPrice + beOffsetTicks * syminfo.mintick
        beActivated := true
        strategy.exit("BUY TP2", from_entry="BUY", stop=activeSL, limit=tp2Price)
    
    // Regular Breakeven at trigger
    else if useBE and not beActivated and (high >= entryPrice + initialRisk * beTriggerR)
        activeSL := entryPrice + beOffsetTicks * syminfo.mintick
        beActivated := true
        if usePartialTP and not tp1Hit
            strategy.exit("BUY TP1", from_entry="BUY", qty=halfQty, stop=activeSL, limit=tp1Price)
            strategy.exit("BUY TP2", from_entry="BUY", stop=activeSL, limit=tp2Price)
        else if usePartialTP and tp1Hit
            strategy.exit("BUY TP2", from_entry="BUY", stop=activeSL, limit=tp2Price)
        else
            strategy.exit("BUY EXIT", from_entry="BUY", stop=activeSL, limit=takeProfit)

    if useTrailing and beActivated
        trailStopPrice = high - atrValue * trailAtrMult
        if trailStopPrice > activeSL
            activeSL := trailStopPrice
            if usePartialTP
                strategy.exit("BUY TP2", from_entry="BUY", stop=activeSL, limit=tp2Price)
            else
                strategy.exit("BUY EXIT", from_entry="BUY", stop=activeSL, limit=takeProfit)

if strategy.position_size < 0
    // Check if TP1 was reached
    if usePartialTP and not tp1Hit and (low <= tp1Price)
        tp1Hit := true
        activeSL := entryPrice - beOffsetTicks * syminfo.mintick
        beActivated := true
        strategy.exit("SELL TP2", from_entry="SELL", stop=activeSL, limit=tp2Price)
    
    // Regular Breakeven at trigger
    else if useBE and not beActivated and (low <= entryPrice - initialRisk * beTriggerR)
        activeSL := entryPrice - beOffsetTicks * syminfo.mintick
        beActivated := true
        if usePartialTP and not tp1Hit
            strategy.exit("SELL TP1", from_entry="SELL", qty=halfQty, stop=activeSL, limit=tp1Price)
            strategy.exit("SELL TP2", from_entry="SELL", stop=activeSL, limit=tp2Price)
        else if usePartialTP and tp1Hit
            strategy.exit("SELL TP2", from_entry="SELL", stop=activeSL, limit=tp2Price)
        else
            strategy.exit("SELL EXIT", from_entry="SELL", stop=activeSL, limit=takeProfit)

    if useTrailing and beActivated
        trailStopPrice = low + atrValue * trailAtrMult
        if trailStopPrice < activeSL
            activeSL := trailStopPrice
            if usePartialTP
                strategy.exit("SELL TP2", from_entry="SELL", stop=activeSL, limit=tp2Price)
            else
                strategy.exit("SELL EXIT", from_entry="SELL", stop=activeSL, limit=takeProfit)

// Position close event: reset active tracking
if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeSL := na
    beActivated := false
    tp1Hit := false
    activeTpBox := na
    activeSlBox := na

//====================================================
// 14. ON-CANDLE TRADE LEVELS & VISUAL CHANNELS
//====================================================

inTrade = strategy.position_size != 0

plotEntry = inTrade and showTradeLines ? entryPrice : na
plotSL = inTrade and showTradeLines ? activeSL : na
plotTP = inTrade and showTradeLines ? (usePartialTP ? tp2Price : takeProfit) : na
plotTP1 = inTrade and showTradeLines and usePartialTP ? tp1Price : na

pEntry = plot(plotEntry, "Entry Price", color=color.aqua, linewidth=2, style=plot.style_linebr)
pSL = plot(plotSL, "Stop Loss (SL)", color=beActivated ? color.yellow : color.red, linewidth=2, style=plot.style_linebr)
pTP = plot(plotTP, "Take Profit (TP2)", color=color.lime, linewidth=2, style=plot.style_linebr)
pTP1 = plot(plotTP1, "Partial Target (TP1)", color=color.yellow, linewidth=1, style=plot.style_linebr)

fill(pEntry, pTP, color=inTrade and showTradeChannels ? color.new(color.green, 86) : na, title="Target Profit Zone (TP)")
fill(pEntry, pSL, color=inTrade and showTradeChannels ? color.new(color.red, 86) : na, title="Risk Zone (SL)")

//====================================================
// 15. ALERTS
//====================================================

alertcondition(buySignal, title="CHINNU S&R BUY",
     message="CHINNU S&R PRO: BUY Signal Confirmed on {{ticker}} {{interval}} at {{close}}")

alertcondition(sellSignal, title="CHINNU S&R SELL",
     message="CHINNU S&R PRO: SELL Signal Confirmed on {{ticker}} {{interval}} at {{close}}")

//====================================================
// 16. ENHANCED DASHBOARD HUD
//====================================================

var table panel = table.new(position.top_right, 2, 14,
     border_width=1, frame_color=color.gray, border_color=color.gray)

stateText = state == 0 ? "WAITING FOR SETUP" :
     state == 1 ? "BULLISH RETEST ZONE" :
     state == 2 ? "BULLISH CONFIRMING" :
     state == -1 ? "BEARISH RETEST ZONE" : "BEARISH CONFIRMING"

stateColor = state == 0 ? color.gray : state > 0 ? color.green : color.red
trendText = trendBull ? "BULLISH" : trendBear ? "BEARISH" : "NEUTRAL"
trendColor = trendBull ? color.green : trendBear ? color.red : color.gray
smcText = smcMode == "Breakout & Retest (BOS)" ? "BOS MODE" : (bullSweepRecent ? "BULL SWEEP" : bearSweepRecent ? "BEAR SWEEP" : "WAITING")
volText = volumeBreakOK ? "PASS" : "WAITING"
sessionText = inSession ? "ACTIVE" : "OUTSIDE"

// Current Position & Open R-Multiple
float openR = na
if strategy.position_size > 0 and not na(initialRisk) and initialRisk > 0
    openR := (close - entryPrice) / initialRisk
else if strategy.position_size < 0 and not na(initialRisk) and initialRisk > 0
    openR := (entryPrice - close) / initialRisk

posText = strategy.position_size > 0 ? ("LONG " + (tp1Hit ? "[TP1 HIT]" : beActivated ? "[BE LOCKED]" : "") + " (" + str.tostring(openR, "+#.##") + "R)") :
          strategy.position_size < 0 ? ("SHORT " + (tp1Hit ? "[TP1 HIT]" : beActivated ? "[BE LOCKED]" : "") + " (" + str.tostring(openR, "+#.##") + "R)") : "FLAT"

posColor = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray

// Live prices for HUD
liveEntryStr = inTrade ? str.tostring(entryPrice, format.mintick) : "---"
liveSLStr = inTrade ? (str.tostring(activeSL, format.mintick) + (beActivated ? " [BE]" : "")) : "---"
liveTPStr = inTrade ? (usePartialTP ? (str.tostring(tp1Price, format.mintick) + " | " + str.tostring(tp2Price, format.mintick)) : (str.tostring(takeProfit, format.mintick))) : "---"

dailyStatusStr = dayLossLimitHit ? "STOPPED (MAX LOSS)" : maxDailyTradesHit ? "DONE (MAX TRADES)" : (str.tostring(dailyTradesCount) + " / " + str.tostring(maxDailyTrades))
dailyStatusColor = dayLossLimitHit ? color.red : maxDailyTradesHit ? color.orange : color.green

if barstate.islast and showDashboard
    table.cell(panel, 0, 0, "CHINNU S&R PRO", bgcolor=color.navy, text_color=color.white)
    table.cell(panel, 1, 0, tfName + " | " + tradeDirection, bgcolor=color.navy, text_color=color.white)

    table.cell(panel, 0, 1, "PROFILE", text_color=color.white)
    table.cell(panel, 1, 1, is5 ? "5M DAY TRADING" : "SWING TRADING", text_color=color.white, bgcolor=color.blue)

    table.cell(panel, 0, 2, "DAILY TRADES", text_color=color.white)
    table.cell(panel, 1, 2, dailyStatusStr, text_color=color.white, bgcolor=dailyStatusColor)

    table.cell(panel, 0, 3, "DAILY PnL", text_color=color.white)
    table.cell(panel, 1, 3, "$" + str.tostring(dailyPnL, "+#.##"), text_color=color.white, bgcolor=dailyPnL >= 0 ? color.green : color.red)

    table.cell(panel, 0, 4, "HTF TREND (" + trendTF + ")", text_color=color.white)
    table.cell(panel, 1, 4, trendText, text_color=color.white, bgcolor=trendColor)

    table.cell(panel, 0, 5, "KILL ZONE", text_color=color.white)
    table.cell(panel, 1, 5, sessionText, text_color=color.white, bgcolor=inSession ? color.green : color.gray)

    table.cell(panel, 0, 6, "SMC STRUCTURE", text_color=color.white)
    table.cell(panel, 1, 6, smcText, text_color=color.white, bgcolor=color.teal)

    table.cell(panel, 0, 7, "SETUP STATE", text_color=color.white)
    table.cell(panel, 1, 7, stateText, text_color=color.white, bgcolor=stateColor)

    table.cell(panel, 0, 8, "LIVE POSITION", text_color=color.white)
    table.cell(panel, 1, 8, posText, text_color=color.white, bgcolor=posColor)

    table.cell(panel, 0, 9, "• ENTRY PRICE", text_color=color.white)
    table.cell(panel, 1, 9, liveEntryStr, text_color=color.white, bgcolor=inTrade ? color.blue : color.gray)

    table.cell(panel, 0, 10, "• STOP LOSS (SL)", text_color=color.white)
    table.cell(panel, 1, 10, liveSLStr, text_color=color.white, bgcolor=inTrade ? (beActivated ? color.olive : color.maroon) : color.gray)

    table.cell(panel, 0, 11, "• TARGET TP (1/2)", text_color=color.white)
    table.cell(panel, 1, 11, liveTPStr, text_color=color.white, bgcolor=inTrade ? color.green : color.gray)

    table.cell(panel, 0, 12, "SIZING MODEL", text_color=color.white)
    table.cell(panel, 1, 12, sizingMode == "Risk % of Equity (1R)" ? (str.tostring(riskPct) + "% (1R)") : sizingMode, text_color=color.white, bgcolor=color.navy)

    table.cell(panel, 0, 13, "DAILY LIQUIDITY", text_color=color.white)
    table.cell(panel, 1, 13, "PDH: " + str.tostring(pdh, format.mintick) + "\nPDL: " + str.tostring(pdl, format.mintick), text_color=color.white, bgcolor=color.purple)
